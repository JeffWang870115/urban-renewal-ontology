    rdfs:comment "原始状态：基本确认；来源：附件1【待核】；手册表11"@zh ;
    ur:basedOn ur:Policy_2026_16 ;
    ur:code "46" ;
    ur:computedFrom ur:Bridge ;
    ur:formula "count(桥梁，危旧状态∈{Ⅰ类不合格级, Ⅱ–Ⅴ类D/E级})"@zh ;
