    ur:inDimension ur:UrbanDistrictDimension ;
    ur:measures ur:UrbanDistrict ;
    ur:name "城市危旧桥梁数量"@zh ;
    ur:orientation "逆向"@zh ;
    ur:unit "座"@zh .

