@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ur: <https://ontology.cset-digital.cn/urban-renewal#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ur:AssociationStandard a owl:Class ;
    rdfs:label "团体标准"@zh ;
    rdfs:subClassOf ur:PolicyStandard .

ur:BasicCompliantResult a owl:Class ;
    rdfs:label "基本达标结果"@zh ;
    rdfs:subClassOf ur:AssessmentResult .

ur:BestEffortRemedy a owl:Class ;
    rdfs:label "尽力解决类整治建议"@zh ;
    rdfs:subClassOf ur:RemediationSuggestion .

ur:CI_C_1 a ur:CheckItem ;
    rdfs:label "业态聚集（核心功能区占比与单一业态占比）"@zh ;
    ur:basedOn ur:Policy_2026_16 ;
    ur:checkItemFor ur:Indicator_24 ;
    ur:checkItemThreshold "核心功能区空间占比≥60%；单一功能业态占比≤70%（按经营面积计）"@zh ;
    ur:checkItemType "阈值型"@zh ;
    ur:checkItemUnit "%"@zh .

ur:CI_C_2 a ur:CheckItem ;
    rdfs:label "步行环境（慢行系统与步道宽度）"@zh ;
    ur:basedOn ur:Policy_2026_16 ;
    ur:checkItemFor ur:Indicator_24 ;
    ur:checkItemThreshold "步道宽度≥1.5；慢行系统与无障碍按 3 个必查点全满足"@zh ;
    ur:checkItemType "阈值型"@zh ;
    ur:checkItemUnit "m"@zh .

ur:CI_C_3 a ur:CheckItem ;
    rdfs:label "交通出行（站点与停靠点距离）"@zh ;
    ur:basedOn ur:Policy_2026_16 ;
    ur:checkItemFor ur:Indicator_24 ;
    ur:checkItemThreshold "500 m 内有地铁站或公交站；100 m 内有出租车与非机动车停靠点"@zh ;
    ur:checkItemType "阈值型"@zh ;
    ur:checkItemUnit "m"@zh .

ur:CI_C_4 a ur:CheckItem ;
    rdfs:label "公共空间（休憩空间密度）"@zh ;
    ur:basedOn ur:Policy_2026_16 ;
    ur:checkItemFor ur:Indicator_24 ;
    ur:checkItemThreshold "每 50 m 1 处休憩空间及设施"@zh ;
    ur:checkItemType "阈值型"@zh ;
    ur:checkItemUnit "m"@zh .

ur:CI_C_5 a ur:CheckItem ;
    rdfs:label "商业特色（历史记忆与民族文化景观）"@zh ;
    ur:basedOn ur:Policy_2026_16 ;
    ur:checkItemFor ur:Indicator_24 ;
    ur:checkItemThreshold "有≥1 处体现历史/民族/文化的景观或设施（建议口径·待核）"@zh ;
    ur:checkItemType "是否型"@zh .

ur:CI_C_6 a ur:CheckItem ;
    rdfs:label "运营服务（无线网络覆盖）"@zh ;
    ur:basedOn ur:Policy_2026_16 ;
    ur:checkItemFor ur:Indicator_24 ;
    ur:checkItemThreshold "街区公共区域 100% 覆盖（建议口径·待核）"@zh ;
    ur:checkItemType "是否型"@zh .

ur:CI_F_1 a ur:CheckItem ;
