    rdfs:range xsd:string .

ur:threshold a owl:DatatypeProperty ;
    rdfs:label "阈值/标准值"@zh ;
    rdfs:domain ur:Indicator ;
    rdfs:range xsd:decimal .

ur:treatmentType a owl:DatatypeProperty ;
    rdfs:label "整治类型"@zh ;
    rdfs:domain ur:RemediationSuggestion ;
    rdfs:range xsd:string .

ur:trendDirection a owl:DatatypeProperty ;
    rdfs:label "趋势方向"@zh ;
    rdfs:domain ur:TemporalTrend ;
    rdfs:range xsd:string .

ur:triggers a owl:ObjectProperty ;
    rdfs:label "触发（直通兼容）"@zh ;
    rdfs:domain ur:Problem ;
    rdfs:range ur:RenewalProject .

ur:unit a owl:DatatypeProperty ;
    rdfs:label "计量单位"@zh ;
    rdfs:domain ur:AssessmentResult,
        ur:DataObject,
        ur:Indicator ;
