    ur:basedOn ur:Policy_2026_16 ;
    ur:checkItemFor ur:Indicator_25 ;
    ur:checkItemThreshold "以片区控规/上位规划为准，符合用地要求（判据建议·待核）"@zh ;
    ur:checkItemType "是否型"@zh .

ur:CI_F_10 a ur:CheckItem ;
