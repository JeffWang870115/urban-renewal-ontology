ur:Indicator_28 a ur:Indicator ;
    rdfs:label "新增各类体育场地面积"@zh ;
    rdfs:comment "原始状态：基本确认；来源：附件1【待核】；手册表11"@zh ;
    ur:basedOn ur:Policy_2026_16 ;
    ur:code "28" ;
    ur:computedFrom ur:SportsVenue ;
    ur:formula "sum(体育场地新增面积，建设年份=上一年度)"@zh ;
    ur:inCategory ur:生态宜居 ;
    ur:inDimension ur:UrbanDistrictDimension ;
    ur:measures ur:UrbanDistrict ;
    ur:name "新增各类体育场地面积"@zh ;
    ur:orientation "正向"@zh ;
    ur:unit "平方米"@zh .

ur:Indicator_31 a ur:Indicator ;
    rdfs:label "新建建筑中绿色建筑占比"@zh ;
    rdfs:comment "原始状态：基本确认；来源：附件1【待核】；手册表11"@zh ;
    ur:basedOn ur:Policy_2026_16 ;
    ur:code "31" ;
    ur:computedFrom ur:Building ;
    ur:formula "Σ新建绿色建筑面积 ÷ Σ新开工建筑面积 × 100%（同一 `Building` 实体按 建设阶段=新开工 + 绿色建筑属性 筛选）"@zh ;
    ur:inCategory ur:生态宜居 ;
    ur:inDimension ur:UrbanDistrictDimension ;
    ur:measures ur:UrbanDistrict ;
    ur:name "新建建筑中绿色建筑占比"@zh ;
    ur:orientation "正向"@zh ;
    ur:threshold "新建建筑全面建成绿色建筑【手册表述，非量化】"@zh ;
    ur:unit "%"@zh .

ur:Indicator_32 a ur:Indicator ;
    rdfs:label "历史文化街区、历史建筑挂牌建档率"@zh ;
    rdfs:comment "原始状态：基本确认；来源：附件1【待核】；手册表11"@zh ;
    ur:basedOn ur:Policy_2026_16 ;
    ur:code "32" ;
    ur:computedFrom ur:HistoricalBuilding ;
    ur:formula "已挂牌建档数 ÷ 已认定公布总数 × 100%"@zh ;
    ur:inCategory ur:历史文化保护利用 ;
    ur:inDimension ur:UrbanDistrictDimension ;
    ur:measures ur:UrbanDistrict ;
    ur:name "历史文化街区、历史建筑挂牌建档率"@zh ;
    ur:orientation "正向"@zh ;
    ur:threshold "100%"@zh ;
    ur:unit "%"@zh .

