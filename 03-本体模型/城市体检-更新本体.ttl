        ur:ExaminationActivity ;
    rdfs:range xsd:gYear .

ur:AverageDailyWaterSupply a owl:Class ;
    rdfs:label "平均日供水量"@zh ;
    rdfs:subClassOf ur:DataObject ;
    ur:feedsInto ur:Indicator_44 .

ur:CityRoadLength a owl:Class ;
    rdfs:label "城市道路长度"@zh ;
    rdfs:subClassOf ur:DataObject ;
    ur:feedsInto ur:Indicator_30 .

ur:ConstructionLand a owl:Class ;
    rdfs:label "建设用地"@zh ;
    rdfs:subClassOf ur:Land ;
    ur:feedsInto ur:Indicator_48 .

ur:DrainageFacility a owl:Class ;
    rdfs:label "排水防涝设施"@zh ;
    rdfs:subClassOf ur:FacilityObject ;
    ur:feedsInto ur:Indicator_43 .

ur:DualUseInfrastructure a owl:Class ;
    rdfs:label "平急两用公共基础设施"@zh ;
    rdfs:subClassOf ur:FacilityObject ;
    ur:feedsInto ur:Indicator_45 .

ur:EmergencyWaterSource a owl:Class ;
    rdfs:label "应急水源"@zh ;
    rdfs:subClassOf ur:FacilityObject ;
    ur:feedsInto ur:Indicator_44 .

ur:FireStation a owl:Class ;
    rdfs:label "消防站"@zh ;
    rdfs:subClassOf ur:FacilityObject ;
    ur:feedsInto ur:Indicator_48 .

ur:Greenway a owl:Class ;
    rdfs:label "绿道"@zh ;
