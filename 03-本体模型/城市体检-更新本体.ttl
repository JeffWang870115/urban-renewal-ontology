    rdfs:label "标准版本号"@zh ;
    rdfs:domain ur:PolicyStandard ;
    rdfs:range xsd:string .

ur:problemCategory a owl:DatatypeProperty ;
    rdfs:label "问题性质"@zh ;
    rdfs:domain ur:Problem ;
    rdfs:range xsd:string .

ur:problemDescription a owl:DatatypeProperty ;
    rdfs:label "问题描述"@zh ;
    rdfs:domain ur:Problem ;
    rdfs:range xsd:string .

