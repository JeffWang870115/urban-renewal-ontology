ur:Indicator_35 a ur:Indicator ;
    rdfs:label "擅自拆除历史文化街区内建筑物、构筑物的数量"@zh ;
    rdfs:comment "原始状态：基本确认；来源：附件1【待核】；手册表11"@zh ;
