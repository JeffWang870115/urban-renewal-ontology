    rdfs:range xsd:string .

ur:greenBuildingLevel a owl:DatatypeProperty ;
    rdfs:label "绿色建筑属性"@zh ;
    rdfs:domain ur:Building ;
    rdfs:range xsd:string .

ur:hasFormulaType a owl:ObjectProperty ;
    rdfs:label "公式类型"@zh ;
    rdfs:domain ur:Indicator ;
    rdfs:range ur:FormulaType .

ur:hasPart a owl:ObjectProperty ;
    rdfs:label "由…组成"@zh ;
    rdfs:domain ur:SpatialUnit ;
    rdfs:range ur:SpatialUnit .

ur:hasTrend a owl:ObjectProperty ;
    rdfs:label "具有趋势"@zh ;
    rdfs:domain ur:Problem ;
    rdfs:range ur:TemporalTrend .

ur:implementedBy a owl:ObjectProperty ;
    rdfs:label "由…实施"@zh ;
    rdfs:domain ur:RenewalProject ;
    rdfs:range ur:Actor .

ur:inCategory a owl:ObjectProperty ;
    rdfs:label "指标属于分类"@zh ;
    rdfs:domain ur:Indicator ;
    rdfs:range ur:IndicatorCategory .

ur:inDimension a owl:ObjectProperty ;
    rdfs:label "指标属于维度"@zh ;
    rdfs:domain ur:Indicator ;
    rdfs:range ur:Dimension .

ur:indicatorValue a owl:DatatypeProperty ;
    rdfs:label "指标值"@zh ;
    rdfs:domain ur:AssessmentResult ;
    rdfs:range xsd:decimal .

ur:investment a owl:DatatypeProperty ;
    rdfs:label "投资额"@zh ;
    rdfs:domain ur:Fund,
        ur:RenewalProject ;
    rdfs:range xsd:decimal .

ur:involves a owl:ObjectProperty ;
    rdfs:label "涉及"@zh ;
    rdfs:domain ur:NegativeEvent ;
    rdfs:range ur:HistoricalBuilding,
        ur:ProtectedObject .

ur:landArea a owl:DatatypeProperty ;
    rdfs:label "用地面积"@zh ;
    rdfs:domain ur:Land ;
    rdfs:range xsd:decimal .

ur:landUseType a owl:DatatypeProperty ;
    rdfs:label "用地类型"@zh ;
    rdfs:domain ur:Land ;
    rdfs:range xsd:string .

ur:leadsTo a owl:ObjectProperty ;
    rdfs:label "立项"@zh ;
    rdfs:domain ur:RemediationSuggestion ;
    rdfs:range ur:RenewalProject .

ur:locatedIn a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "位于"@zh ;
    rdfs:domain ur:Land,
        ur:Problem,
        ur:SpatialUnit ;
    rdfs:range ur:SpatialUnit .

ur:locationDescription a owl:DatatypeProperty ;
    rdfs:label "整治区域描述"@zh ;
    rdfs:domain ur:RemediationSuggestion ;
    rdfs:range xsd:string .

ur:mappingWeight a owl:DatatypeProperty ;
    rdfs:label "映射权重"@zh ;
    rdfs:domain ur:ProblemIndicatorMapping ;
    rdfs:range xsd:decimal .

ur:mapsToIndicator a owl:ObjectProperty ;
    rdfs:label "映射到指标"@zh ;
    rdfs:domain ur:ProblemIndicatorMapping ;
    rdfs:range ur:Indicator .

ur:mapsToProblem a owl:ObjectProperty ;
    rdfs:label "映射到问题"@zh ;
    rdfs:domain ur:ProblemIndicatorMapping ;
    rdfs:range ur:Problem .

ur:measures a owl:ObjectProperty ;
    rdfs:label "度量对象"@zh ;
