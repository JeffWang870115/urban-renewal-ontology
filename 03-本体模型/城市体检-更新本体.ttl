    ur:orientation "正向"@zh ;
    ur:threshold "快速路≥30、主干路≥20千米/小时"@zh ;
    ur:unit "千米/小时"@zh .

ur:Indicator_39 a ur:Indicator ;
    rdfs:label "公租房保障最长轮候时间"@zh ;
    rdfs:comment "原始状态：基本确认；来源：附件1【待核】；手册表11"@zh ;
    ur:basedOn ur:Policy_2026_16 ;
    ur:code "39" ;
    ur:computedFrom ur:PublicRentalHousing ;
    ur:formula "max(轮候时间)"@zh ;
    ur:inCategory ur:产城融合职住平衡 ;
