    ur:feedsInto ur:Indicator_27 .

ur:Indicator_1 a ur:Indicator ;
    rdfs:label "存在结构安全隐患的住宅数量"@zh ;
    rdfs:comment "原始状态：基本确认；来源：附件1【待核】；手册表1"@zh ;
    ur:basedOn ur:Policy_2026_16 ;
    ur:code "1" ;
    ur:computedFrom ur:Building ;
    ur:formula "count(住宅，结构安全状态≠安全)"@zh ;
    ur:inCategory ur:安全耐久 ;
    ur:inDimension ur:HousingDimension ;
    ur:measures ur:Building ;
    ur:name "存在结构安全隐患的住宅数量"@zh ;
    ur:orientation "逆向"@zh ;
    ur:unit "栋"@zh .

