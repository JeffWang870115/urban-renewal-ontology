ur:usesIndicator a owl:ObjectProperty ;
    rdfs:label "采用指标"@zh ;
    rdfs:domain ur:ExaminationActivity ;
    rdfs:range ur:Indicator .

ur:vacancyStatus a owl:DatatypeProperty ;
    rdfs:label "空置状态"@zh ;
