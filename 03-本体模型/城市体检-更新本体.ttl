    rdfs:label "由…评价"@zh ;
    rdfs:domain ur:Indicator ;
    rdfs:range ur:EvaluationRule .

ur:examines a owl:ObjectProperty ;
    rdfs:label "针对"@zh ;
    rdfs:domain ur:ExaminationActivity ;
    rdfs:range ur:SpatialUnit .

ur:floorArea a owl:DatatypeProperty ;
    rdfs:label "建筑面积"@zh ;
    rdfs:domain ur:Building,
        ur:RenewalObject ;
    rdfs:range xsd:decimal .

ur:floorCount a owl:DatatypeProperty ;
    rdfs:label "层数"@zh ;
    rdfs:domain ur:Building ;
    rdfs:range xsd:integer .

ur:formula a owl:DatatypeProperty ;
    rdfs:label "计算公式"@zh ;
    rdfs:domain ur:Indicator ;
    rdfs:range xsd:string .

ur:fundedBy a owl:ObjectProperty ;
    rdfs:label "由…出资"@zh ;
    rdfs:domain ur:RenewalProject ;
    rdfs:range ur:Fund .

ur:gasSafetyStatus a owl:DatatypeProperty ;
    rdfs:label "燃气安全状态"@zh ;
