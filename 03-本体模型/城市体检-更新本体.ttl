        owl:ObjectProperty ;
    rdfs:label "产生"@zh ;
    rdfs:domain ur:ExaminationActivity ;
    rdfs:range ur:AssessmentResult .

ur:propertyManagementStatus a owl:DatatypeProperty ;
    rdfs:label "物业管理实施状态"@zh ;
    rdfs:domain ur:ResidentialQuarter ;
    rdfs:range xsd:boolean .

ur:proposes a owl:ObjectProperty ;
    rdfs:label "提出"@zh ;
    rdfs:domain ur:Problem ;
    rdfs:range ur:RemediationSuggestion .

ur:referencePeriod a owl:DatatypeProperty ;
    rdfs:label "参考周期"@zh ;
    rdfs:domain ur:TemporalTrend ;
    rdfs:range xsd:string .

ur:remediationStatus a owl:DatatypeProperty ;
    rdfs:label "整治状态"@zh ;
    rdfs:domain ur:Problem ;
    rdfs:range xsd:string .

