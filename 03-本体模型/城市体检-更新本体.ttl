    rdfs:label "指标导向"@zh ;
    rdfs:domain ur:Indicator ;
    rdfs:range xsd:string .

ur:parkingViolationStatus a owl:DatatypeProperty ;
    rdfs:label "乱停乱放状态"@zh ;
    rdfs:domain ur:Road ;
    rdfs:range xsd:boolean .

