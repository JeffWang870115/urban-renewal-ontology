@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ur: <https://ontology.cset-digital.cn/urban-renewal#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ur:AssessmentRule a owl:Class ;
    rdfs:label "达标评价规则"@zh ;
    rdfs:subClassOf ur:EvaluationRule .

ur:AssociationStandard a owl:Class ;
    rdfs:label "团体标准"@zh ;
    rdfs:subClassOf ur:PolicyStandard .

ur:CentralTransfer a owl:Class ;
    rdfs:label "中央财政转移支付"@zh ;
    rdfs:subClassOf ur:Fund .

ur:CollectionMethod_专业检测 a ur:CollectionMethod ;
    rdfs:label "专业检测"@zh .

ur:CollectionMethod_基层填报 a ur:CollectionMethod ;
    rdfs:label "基层填报"@zh .

ur:CollectionMethod_大数据 a ur:CollectionMethod ;
    rdfs:label "大数据"@zh .

ur:CollectionMethod_普查数据 a ur:CollectionMethod ;
    rdfs:label "普查数据"@zh .

ur:CollectionMethod_现场调研 a ur:CollectionMethod ;
    rdfs:label "现场调研"@zh .

ur:CollectionMethod_系统对接 a ur:CollectionMethod ;
    rdfs:label "系统对接"@zh .

ur:CollectionMethod_统计年报 a ur:CollectionMethod ;
    rdfs:label "统计年报"@zh .

ur:CollectionMethod_遥感解译 a ur:CollectionMethod ;
    rdfs:label "遥感解译"@zh .

ur:CollectionMethod_部门填报 a ur:CollectionMethod ;
    rdfs:label "部门填报"@zh .

ur:CompleteCommunity a owl:Class ;
    rdfs:label "完整社区"@zh ;
    rdfs:subClassOf ur:RenewalObject .

ur:CrossDomainRule a owl:Class ;
    rdfs:label "跨域规则"@zh ;
    rdfs:subClassOf ur:EvaluationRule .

ur:FormulaType_avg a ur:FormulaType ;
    rdfs:label "avg"@zh .

ur:FormulaType_count a ur:FormulaType ;
    rdfs:label "count"@zh .

ur:FormulaType_diff a ur:FormulaType ;
    rdfs:label "diff"@zh .

ur:FormulaType_max a ur:FormulaType ;
    rdfs:label "max"@zh .

ur:FormulaType_ratio a ur:FormulaType ;
    rdfs:label "ratio"@zh .

ur:FormulaType_ratioPercent a ur:FormulaType ;
    rdfs:label "ratioPercent"@zh .

ur:FormulaType_sum a ur:FormulaType ;
    rdfs:label "sum"@zh .

ur:Government a owl:Class ;
    rdfs:label "政府/主管部门"@zh ;
    rdfs:subClassOf ur:Actor .

ur:Implementer a owl:Class ;
    rdfs:label "实施主体"@zh ;
    rdfs:subClassOf ur:Actor .

ur:IndustryStandard a owl:Class ;
    rdfs:label "行业标准"@zh ;
    rdfs:subClassOf ur:PolicyStandard .

ur:Infrastructure a owl:Class ;
    rdfs:label "市政基础设施"@zh ;
    rdfs:subClassOf ur:RenewalObject .

ur:LocalFiscal a owl:Class ;
    rdfs:label "地方财政"@zh ;
    rdfs:subClassOf ur:Fund .

ur:LocalRegulation a owl:Class ;
    rdfs:label "地方条例"@zh ;
    rdfs:subClassOf ur:PolicyStandard .

ur:MicroRenewal a owl:Class ;
    rdfs:label "微改造"@zh ;
    rdfs:subClassOf ur:RenewalApproach .

ur:NationalStandard a owl:Class ;
    rdfs:label "国家标准"@zh ;
    rdfs:subClassOf ur:PolicyStandard .

ur:OldResidentialQuarter a owl:Class ;
    rdfs:label "老旧小区"@zh ;
    rdfs:subClassOf ur:RenewalObject .

ur:Reconstruction a owl:Class ;
    rdfs:label "拆除重建"@zh ;
    rdfs:subClassOf ur:RenewalApproach .

ur:Renovation a owl:Class ;
    rdfs:label "整治提升"@zh ;
    rdfs:subClassOf ur:RenewalApproach .

ur:Resident a owl:Class ;
    rdfs:label "居民"@zh ;
    rdfs:subClassOf ur:Actor .

ur:Retrofit a owl:Class ;
    rdfs:label "保留改造提升"@zh ;
    rdfs:subClassOf ur:RenewalApproach .

ur:RightsHolder a owl:Class ;
    rdfs:label "产权人"@zh ;
    rdfs:subClassOf ur:Actor .

ur:SocialCapital a owl:Class ;
    rdfs:label "社会资本"@zh ;
    rdfs:subClassOf ur:Actor .

ur:SocialCapitalFund a owl:Class ;
    rdfs:label "社会资本"@zh ;
    rdfs:subClassOf ur:Fund .

ur:TechnicalGuide a owl:Class ;
    rdfs:label "技术导则"@zh ;
    rdfs:subClassOf ur:PolicyStandard .

ur:TreatmentType_尽力解决 a ur:TreatmentType ;
    rdfs:label "尽力解决"@zh .

ur:TreatmentType_限时解决 a ur:TreatmentType ;
    rdfs:label "限时解决"@zh .

ur:WarningRule a owl:Class ;
    rdfs:label "预警规则"@zh ;
    rdfs:subClassOf ur:EvaluationRule .

ur:actsOn a owl:ObjectProperty ;
    rdfs:label "作用于"@zh ;
    rdfs:domain ur:RemediationSuggestion,
        ur:RenewalProject ;
    rdfs:range ur:RenewalObject,
        ur:SpatialUnit .

ur:adoptsApproach a owl:ObjectProperty ;
    rdfs:label "采用方式"@zh ;
    rdfs:domain ur:RenewalProject ;
    rdfs:range ur:RenewalApproach .

ur:agingAdaptationNeed a owl:DatatypeProperty ;
    rdfs:label "适老化改造需求"@zh ;
    rdfs:domain ur:Building ;
    rdfs:range xsd:boolean .

ur:archiveStatus a owl:DatatypeProperty ;
    rdfs:label "挂牌建档状态"@zh ;
    rdfs:domain ur:HistoricalBuilding ;
    rdfs:range xsd:string .

ur:assignedTo a owl:ObjectProperty ;
    rdfs:label "责任单位"@zh ;
    rdfs:domain ur:RemediationSuggestion ;
    rdfs:range ur:Actor .

ur:basedOn a owl:ObjectProperty ;
    rdfs:label "依据"@zh ;
    rdfs:domain ur:Indicator,
        ur:RenewalProject ;
    rdfs:range ur:PolicyStandard .

ur:belongsTo a owl:ObjectProperty ;
    rdfs:label "属于"@zh ;
    rdfs:domain ur:DataObject ;
    rdfs:range ur:SpatialUnit .

ur:belongsToDimension a owl:ObjectProperty ;
    rdfs:label "分类归属维度"@zh ;
    rdfs:domain ur:IndicatorCategory ;
    rdfs:range ur:Dimension .

ur:buildingNature a owl:DatatypeProperty ;
    rdfs:label "建筑性质"@zh ;
    rdfs:domain ur:Building ;
    rdfs:range xsd:string .

ur:causeType a owl:DatatypeProperty ;
    rdfs:label "病因类型"@zh ;
    rdfs:domain ur:ProblemCause ;
    rdfs:range xsd:string .

ur:causedBy a owl:ObjectProperty ;
    rdfs:label "病因归因"@zh ;
    rdfs:domain ur:Problem ;
    rdfs:range ur:ProblemCause .

ur:code a owl:DatatypeProperty ;
    rdfs:label "编码"@zh ;
    rdfs:domain ur:DataObject,
        ur:Dimension,
        ur:Indicator,
        ur:RenewalProject,
        ur:SpatialUnit ;
    rdfs:range xsd:string .

ur:collectedAt a owl:DatatypeProperty ;
    rdfs:label "采集空间层级"@zh ;
    rdfs:domain ur:DataObject ;
    rdfs:range xsd:string .

ur:collectedVia a owl:ObjectProperty ;
    rdfs:label "采集方式"@zh ;
    rdfs:domain ur:DataObject ;
    rdfs:range ur:CollectionMethod .

ur:collectionMethod a owl:DatatypeProperty ;
    rdfs:label "采集/统计方法"@zh ;
    rdfs:domain ur:DataObject ;
    rdfs:range xsd:string .

ur:complianceStatus a owl:DatatypeProperty ;
    rdfs:label "配建达标状态"@zh ;
    rdfs:domain ur:CulturalActivityCenter,
        ur:ElderlyCareFacility,
        ur:InfantCareFacility,
        ur:MultiFunctionSportsGround,
        ur:PublicActivityVenue ;
    rdfs:range xsd:string .

ur:computedFrom a owl:ObjectProperty ;
    rdfs:label "由…计算"@zh ;
    rdfs:domain ur:Indicator ;
    rdfs:range ur:DataObjectRoleUnion ;
    owl:inverseOf ur:feedsInto .

ur:configuredStatus a owl:DatatypeProperty ;
    rdfs:label "配建状态"@zh ;
    rdfs:domain ur:EVChargingPile,
        ur:EbikeChargingFacility,
        ur:ParkingSpace ;
    rdfs:range xsd:string .

ur:constructionStage a owl:DatatypeProperty ;
    rdfs:label "建设阶段"@zh ;
    rdfs:domain ur:Building ;
    rdfs:range xsd:string .

ur:constructionYear a owl:DatatypeProperty ;
    rdfs:label "建成年代"@zh ;
    rdfs:domain ur:Building ;
    rdfs:range xsd:gYear .

ur:corridorSafetyStatus a owl:DatatypeProperty ;
    rdfs:label "楼道安全状态"@zh ;
    rdfs:domain ur:Building ;
    rdfs:range xsd:string .

ur:dataSource a owl:DatatypeProperty ;
    rdfs:label "数据来源"@zh ;
    rdfs:domain ur:DataObject ;
    rdfs:range xsd:string .

ur:definition a owl:DatatypeProperty ;
    rdfs:label "口径定义"@zh ;
    rdfs:domain ur:DataObject ;
    rdfs:range xsd:string .

ur:demolishedStatus a owl:DatatypeProperty ;
