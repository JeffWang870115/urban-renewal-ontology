ur:monitoringStatus a owl:DatatypeProperty ;
    rdfs:label "监测状态"@zh ;
    rdfs:domain ur:LifelineRiskPoint,
        ur:RiskyConstructionWorks ;
    rdfs:range xsd:string .

ur:name a owl:DatatypeProperty ;
    rdfs:label "名称"@zh ;
    rdfs:range xsd:string .

ur:occursIn a owl:ObjectProperty ;
    rdfs:label "发生于"@zh ;
    rdfs:domain ur:ExaminationActivity,
        ur:RenewalProject ;
    rdfs:range ur:TimePeriod .

ur:ontology a owl:Ontology ;
    rdfs:label "城市体检与更新本体"@zh ;
    rdfs:comment "由 03-本体模型/_gen_ttl.py 导出；TBox 源 = 类与层级.md / 属性与关系.md；ABox 源 = 04-指标映射/55项指标.yaml。命名空间为占位【待核】。"@zh ;
    owl:versionInfo "v0.1-export-2026-10-10" .

