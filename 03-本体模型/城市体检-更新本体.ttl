    rdfs:label "时序/工期"@zh ;
    rdfs:domain ur:RenewalProject ;
    rdfs:range xsd:string .

ur:energyRetrofitNeed a owl:DatatypeProperty ;
    rdfs:label "节能改造需求"@zh ;
    rdfs:domain ur:Building ;
    rdfs:range xsd:boolean .

ur:envelopeSafetyStatus a owl:DatatypeProperty ;
    rdfs:label "围护安全状态"@zh ;
    rdfs:domain ur:Building ;
    rdfs:range xsd:string .

