    rdfs:range xsd:boolean .

ur:derivedFrom a owl:ObjectProperty ;
    rdfs:label "由…导出"@zh ;
    rdfs:domain ur:Problem ;
    rdfs:range ur:AssessmentResult .

ur:digitalRetrofitNeed a owl:DatatypeProperty ;
    rdfs:label "数字化改造需求"@zh ;
    rdfs:domain ur:Building ;
    rdfs:range xsd:boolean .

ur:dilapidatedStatus a owl:DatatypeProperty ;
    rdfs:label "危旧状态"@zh ;
    rdfs:domain ur:Bridge,
        ur:Building ;
    rdfs:range xsd:string .

