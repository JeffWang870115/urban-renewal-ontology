ur:Indicator_37 a ur:Indicator ;
    rdfs:label "城市高峰期机动车平均速度"@zh ;
    rdfs:comment "原始状态：基本确认；来源：附件1【待核】；手册表11"@zh ;
    ur:basedOn ur:Policy_2026_16 ;
    ur:code "37" ;
    ur:computedFrom ur:VehicleTravelSpeed ;
    ur:formula "avg(机动车高峰期行驶速度观测值)"@zh ;
    ur:inCategory ur:产城融合职住平衡 ;
    ur:inDimension ur:UrbanDistrictDimension ;
