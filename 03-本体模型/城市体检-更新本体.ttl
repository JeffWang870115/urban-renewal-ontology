    rdfs:domain ur:TemporalTrend ;
    rdfs:range xsd:string .

ur:referenceValue a owl:DatatypeProperty ;
    rdfs:label "参考值"@zh ;
    rdfs:domain ur:EvaluationReference ;
    rdfs:range xsd:decimal .

ur:remediationStatus a owl:DatatypeProperty ;
    rdfs:label "整治状态"@zh ;
    rdfs:domain ur:Problem ;
    rdfs:range xsd:string .

ur:renewalNeed a owl:DatatypeProperty ;
    rdfs:label "改造需求"@zh ;
    rdfs:domain ur:Union_renewalNeed_dom ;
    rdfs:range xsd:boolean .

ur:renovationStatus a owl:DatatypeProperty ;
    rdfs:label "改造完成状态"@zh ;
    rdfs:domain ur:Union_renovationStatus_dom ;
    rdfs:range xsd:string .

ur:residentPopulation a owl:DatatypeProperty ;
    rdfs:label "常住人口"@zh ;
    rdfs:domain ur:SpatialUnit ;
    rdfs:range xsd:integer .

ur:reusesBandsOf a owl:ObjectProperty ;
    rdfs:label "档次复用于"@zh ;
    rdfs:domain ur:EvaluationReference ;
    rdfs:range ur:EvaluationReference .

ur:revealsProblem a owl:ObjectProperty ;
    rdfs:label "揭示"@zh ;
    rdfs:domain ur:AssessmentResult ;
    rdfs:range ur:Problem .

ur:rqCount a owl:DatatypeProperty ;
    rdfs:label "小区数量"@zh ;
    rdfs:domain ur:Community ;
    rdfs:range xsd:integer .

ur:rqType a owl:DatatypeProperty ;
    rdfs:label "小区类型"@zh ;
    rdfs:domain ur:ResidentialQuarter ;
    rdfs:range xsd:string .

ur:severity a owl:DatatypeProperty ;
    rdfs:label "严重程度"@zh ;
    rdfs:domain ur:Problem ;
    rdfs:range xsd:decimal .

ur:smartFireMonitorStatus a owl:DatatypeProperty ;
    rdfs:label "智能化火灾监测配置状态"@zh ;
    rdfs:domain ur:Building ;
    rdfs:range xsd:boolean .

ur:smartParcelLocker a owl:DatatypeProperty ;
    rdfs:label "智能信包箱"@zh ;
    rdfs:domain ur:ResidentialQuarter ;
    rdfs:range xsd:boolean .

ur:smartRetrofitNeed a owl:DatatypeProperty ;
    rdfs:label "智慧化改造需求"@zh ;
    rdfs:domain ur:ResidentialQuarter ;
    rdfs:range xsd:boolean .

ur:smartSecurity a owl:DatatypeProperty ;
    rdfs:label "智能安防"@zh ;
    rdfs:domain ur:ResidentialQuarter ;
    rdfs:range xsd:boolean .

ur:sourceScope a owl:DatatypeProperty ;
    rdfs:label "来源口径"@zh ;
    rdfs:domain ur:EvaluationReference ;
    rdfs:range xsd:string .

ur:structureSafetyStatus a owl:DatatypeProperty ;
    rdfs:label "结构安全状态"@zh ;
    rdfs:domain ur:Building ;
    rdfs:range xsd:string .

ur:suggestionText a owl:DatatypeProperty ;
    rdfs:label "整治建议文本"@zh ;
    rdfs:domain ur:RemediationSuggestion ;
    rdfs:range xsd:string .

ur:threshold a owl:DatatypeProperty ;
    rdfs:label "阈值/标准值"@zh ;
    rdfs:domain ur:Indicator ;
    rdfs:range xsd:decimal .

ur:totalFloorArea a owl:DatatypeProperty ;
    rdfs:label "总建筑面积"@zh ;
    rdfs:domain ur:ResidentialQuarter ;
    rdfs:range xsd:decimal .

ur:treatmentType a owl:DatatypeProperty ;
    rdfs:label "整治类型"@zh ;
    rdfs:domain ur:RemediationSuggestion ;
    rdfs:range xsd:string .

ur:trendDirection a owl:DatatypeProperty ;
    rdfs:label "趋势方向"@zh ;
    rdfs:domain ur:TemporalTrend ;
    rdfs:range xsd:string .

ur:triggers a owl:ObjectProperty ;
    rdfs:label "触发（直通兼容）"@zh ;
    rdfs:domain ur:Problem ;
    rdfs:range ur:RenewalProject .

ur:unit a owl:DatatypeProperty ;
    rdfs:label "计量单位"@zh ;
    rdfs:domain ur:Union_unit_dom ;
    rdfs:range xsd:string .

ur:unitCount a owl:DatatypeProperty ;
    rdfs:label "单元数量"@zh ;
    rdfs:domain ur:Building ;
    rdfs:range xsd:integer .

ur:usesIndicator a owl:ObjectProperty ;
    rdfs:label "采用指标"@zh ;
    rdfs:domain ur:ExaminationActivity ;
    rdfs:range ur:Indicator .

ur:usesReference a owl:ObjectProperty ;
    rdfs:label "使用参考值"@zh ;
    rdfs:domain ur:EvaluationRule ;
    rdfs:range ur:EvaluationReference .

ur:vacancyStatus a owl:DatatypeProperty ;
    rdfs:label "空置状态"@zh ;
    rdfs:domain ur:HistoricalBuilding ;
    rdfs:range xsd:string .

ur:validPeriod a owl:DatatypeProperty ;
    rdfs:label "适用时期"@zh ;
    rdfs:domain ur:EvaluationReference ;
    rdfs:range xsd:string .

ur:wasteSortingStationCount a owl:DatatypeProperty ;
    rdfs:label "垃圾分类点数量"@zh ;
    rdfs:domain ur:ResidentialQuarter ;
    rdfs:range xsd:integer .

ur:wasteSortingStatus a owl:DatatypeProperty ;
    rdfs:label "生活垃圾分类实施状态"@zh ;
    rdfs:domain ur:ResidentialQuarter ;
    rdfs:range xsd:boolean .

ur:year a owl:DatatypeProperty ;
    rdfs:label "统计年份"@zh ;
    rdfs:domain ur:Union_year_dom ;
    rdfs:range xsd:gYear .

ur:AverageDailyWaterSupply a owl:Class ;
    rdfs:label "平均日供水量"@zh ;
    rdfs:subClassOf ur:DataObject ;
    ur:feedsInto ur:Indicator_44 .

ur:CityRoadLength a owl:Class ;
    rdfs:label "城市道路长度"@zh ;
    rdfs:subClassOf ur:DataObject ;
    ur:feedsInto ur:Indicator_30 .

ur:ConstructionLand a owl:Class ;
    rdfs:label "建设用地"@zh ;
    rdfs:subClassOf ur:Land ;
    ur:feedsInto ur:Indicator_48 .

ur:DrainageFacility a owl:Class ;
    rdfs:label "排水防涝设施"@zh ;
    rdfs:subClassOf ur:FacilityObject ;
    ur:feedsInto ur:Indicator_43 .

ur:DualUseInfrastructure a owl:Class ;
    rdfs:label "平急两用公共基础设施"@zh ;
    rdfs:subClassOf ur:FacilityObject ;
    ur:feedsInto ur:Indicator_45 .

ur:EmergencyWaterSource a owl:Class ;
    rdfs:label "应急水源"@zh ;
    rdfs:subClassOf ur:FacilityObject ;
    ur:feedsInto ur:Indicator_44 .

ur:FireStation a owl:Class ;
    rdfs:label "消防站"@zh ;
    rdfs:subClassOf ur:FacilityObject ;
    ur:feedsInto ur:Indicator_48 .

ur:Greenway a owl:Class ;
    rdfs:label "绿道"@zh ;
    rdfs:subClassOf ur:LineObject ;
    ur:feedsInto ur:Indicator_27 .

ur:Indicator_10 a ur:Indicator ;
    rdfs:label "未达标配建婴幼儿托育设施的社区数量"@zh ;
    rdfs:comment "原始状态：基本确认；来源：附件1【待核】；手册表2"@zh ;
    ur:basedOn ur:Policy_2026_16 ;
    ur:code "10" ;
    ur:computedFrom ur:InfantCareFacility ;
    ur:formula "count(社区，托育设施配建不达标)"@zh ;
    ur:inCategory ur:设施完善 ;
    ur:inDimension ur:CommunityDimension ;
    ur:measures ur:Community ;
    ur:name "未达标配建婴幼儿托育设施的社区数量"@zh ;
    ur:orientation "逆向"@zh ;
    ur:unit "个"@zh .

ur:Indicator_11 a ur:Indicator ;
    rdfs:label "停车泊位存在较大缺口数的小区数"@zh ;
    rdfs:comment "原始状态：基本确认；来源：附件1【待核】；手册表2"@zh ;
    ur:basedOn ur:Policy_2026_16 ;
    ur:code "11" ;
    ur:computedFrom ur:ParkingSpace ;
    ur:formula "count(小区，停车泊位低于1车位/户或统筹周边仍不足)"@zh ;
    ur:inCategory ur:设施完善 ;
    ur:inDimension ur:ResidentialQuarterDimension ;
    ur:measures ur:ResidentialQuarter ;
    ur:name "停车泊位存在较大缺口数的小区数"@zh ;
    ur:orientation "逆向"@zh ;
    ur:unit "个"@zh .

ur:Indicator_12 a ur:Indicator ;
    rdfs:label "新能源汽车充电桩缺口数"@zh ;
    rdfs:comment "原始状态：基本确认；来源：附件1【待核】；手册表2"@zh ;
    ur:basedOn ur:Policy_2026_16 ;
    ur:code "12" ;
    ur:computedFrom ur:EVChargingPile ;
    ur:formula "Σ(居民需求 − 供给)，即充电桩缺口数"@zh ;
    ur:inCategory ur:设施完善 ;
    ur:inDimension ur:ResidentialQuarterDimension ;
    ur:measures ur:ResidentialQuarter ;
    ur:name "新能源汽车充电桩缺口数"@zh ;
    ur:orientation "逆向"@zh ;
    ur:unit "个"@zh .

ur:Indicator_13 a ur:Indicator ;
    rdfs:label "未配建电动自行车充电设施的小区数量"@zh ;
    rdfs:comment "原始状态：基本确认；来源：附件1【待核】；手册表2"@zh ;
    ur:basedOn ur:Policy_2026_16 ;
    ur:code "13" ;
    ur:computedFrom ur:EbikeChargingFacility ;
    ur:formula "count(小区，电动自行车充电设施未配建)"@zh ;
    ur:inCategory ur:设施完善 ;
    ur:inDimension ur:ResidentialQuarterDimension ;
    ur:measures ur:ResidentialQuarter ;
    ur:name "未配建电动自行车充电设施的小区数量"@zh ;
    ur:orientation "逆向"@zh ;
    ur:unit "个"@zh .

