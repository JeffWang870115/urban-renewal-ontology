@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ur: <https://ontology.cset-digital.cn/urban-renewal#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:NodeShape ;
    sh:message "measures 须指向其 inDimension 对应的空间层级"@zh ;
    sh:or ( [ sh:property [ sh:hasValue ur:HousingDimension ;
                        sh:path ur:inDimension ],
                    [ sh:hasValue ur:Building ;
                        sh:path ur:measures ] ] [ sh:property [ sh:hasValue ur:ResidentialQuarterDimension ;
                        sh:path ur:inDimension ],
                    [ sh:hasValue ur:ResidentialQuarter ;
                        sh:path ur:measures ] ] [ sh:property [ sh:hasValue ur:CommunityDimension ;
                        sh:path ur:inDimension ],
                    [ sh:hasValue ur:Community ;
                        sh:path ur:measures ] ] [ sh:property [ sh:hasValue ur:NeighborhoodDimension ;
                        sh:path ur:inDimension ],
                    [ sh:hasValue ur:Neighborhood ;
                        sh:path ur:measures ] ] [ sh:property [ sh:hasValue ur:UrbanDistrictDimension ;
                        sh:path ur:inDimension ],
                    [ sh:hasValue ur:UrbanDistrict ;
                        sh:path ur:measures ] ] ) ;
    sh:property [ sh:in ( ur:AverageDailyWaterSupply ur:Bridge ur:Building ur:BuiltUpArea ur:CityRoadLength ur:ConstructionLand ur:CulturalActivityCenter ur:DrainageFacility ur:DualUseInfrastructure ur:EVChargingPile ur:EbikeChargingFacility ur:ElderlyCareFacility ur:EmergencyShelter ur:EmergencyWaterSource ur:FireStation ur:GasPipeline ur:Greenway ur:HistoricBlockBuilding ur:HistoricalBuilding ur:InfantCareFacility ur:LifelineRiskPoint ur:MiddleSchool ur:MultiFunctionSportsGround ur:NegativeEvent ur:OldCommercialBlock ur:OldIndustrialArea ur:OldResidentialBlock ur:ParkGreenSpace ur:ParkingSpace ur:PermanentPopulation ur:Problem ur:ProjectsUnderConstruction ur:ProtectedObject ur:PublicActivityVenue ur:PublicCulturalFacility ur:PublicRentalHousing ur:RailCommutingVolume ur:RailTransitStation ur:RenewalProject ur:ResidentialLand ur:ResidentialQuarter ur:RiskyConstructionWorks ur:Road ur:SafetyAccident ur:SportsVenue ur:TotalCommutingVolume ur:UrbanOperationPlatform ur:UrbanVillage ur:VehicleTravelSpeed ur:Walkway ) ;
            sh:message "指标须有 ≥1 个数据对象，且取值须在角色类值域内"@zh ;
            sh:minCount 1 ;
            sh:path ur:computedFrom ],
        [ sh:in ( "仅本尺度有效"@zh "可同尺度求和"@zh "可跨尺度汇总"@zh ) ;
            sh:maxCount 1 ;
            sh:message "聚合规则若标，须在 仅本尺度有效/可同尺度求和/可跨尺度汇总 中择一（W-B03；比率型不可跨层加总）"@zh ;
            sh:path ur:aggregationRule ],
        [ sh:maxCount 1 ;
            sh:message "指标一级分类 0..1（54、55 无分类）"@zh ;
            sh:path ur:inCategory ],
        [ sh:message "指标须有依据（basedOn）"@zh ;
            sh:minCount 1 ;
            sh:path ur:basedOn ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "computedFrom 指向 ≥2 个数据对象的指标必须带 formula"@zh ;
            sh:select "SELECT $this WHERE { $this <https://ontology.cset-digital.cn/urban-renewal#computedFrom> ?o1, ?o2 . FILTER(?o1 != ?o2) FILTER NOT EXISTS { $this <https://ontology.cset-digital.cn/urban-renewal#formula> ?f } }" ] ;
    sh:targetClass ur:Indicator .

[] a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "极值/周期评估结果须指明针对哪个指标（ofIndicator 1..1）"@zh ;
            sh:minCount 1 ;
            sh:path ur:ofIndicator ],
        [ sh:class ur:SpatialUnit ;
            sh:maxCount 1 ;
            sh:message "极值/周期评估结果须落到具体空间单元（assesses 1..1）"@zh ;
            sh:minCount 1 ;
            sh:path ur:assesses ],
        [ sh:message "极值/周期评估结果须有指标值（数值型，极值取自观测）"@zh ;
            sh:minCount 1 ;
            sh:path ur:indicatorValue ] ;
    sh:targetClass ur:ExtremeValueAssessmentResult .

[] a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "加权/复合评估结果须指明针对哪个指标（ofIndicator 1..1）"@zh ;
            sh:minCount 1 ;
            sh:path ur:ofIndicator ],
        [ sh:class ur:SpatialUnit ;
            sh:maxCount 1 ;
            sh:message "加权/复合评估结果须落到具体空间单元（assesses 1..1）"@zh ;
            sh:minCount 1 ;
            sh:path ur:assesses ],
        [ sh:message "加权/复合评估结果须有指标值（数值型，加权汇总）"@zh ;
            sh:minCount 1 ;
            sh:path ur:indicatorValue ] ;
    sh:targetClass ur:WeightedAssessmentResult .

[] a sh:NodeShape ;
    sh:property [ sh:message "设施占地面积须 ≥ 0（单位 ㎡）"@zh ;
            sh:minInclusive 0 ;
            sh:path ur:facilityArea ] ;
    sh:targetClass ur:FacilityObject,
        ur:SpaceObject .

[] a sh:NodeShape ;
    sh:property [ sh:message "核查项须标判定类型（是否型/阈值型/比率型）"@zh ;
            sh:minCount 1 ;
            sh:path ur:checkItemType ],
        [ sh:class ur:Indicator ;
            sh:maxCount 1 ;
            sh:message "核查项须指明服务哪个指标（checkItemFor 1..1）"@zh ;
            sh:minCount 1 ;
            sh:path ur:checkItemFor ] ;
    sh:targetClass ur:CheckItem .

[] a sh:NodeShape ;
    sh:property [ sh:class ur:SpatialScale ;
            sh:maxCount 1 ;
            sh:message "评价参考值须声明适用空间尺度（1..1，取自 SpatialScale）"@zh ;
            sh:minCount 1 ;
            sh:path ur:appliesToScale ] ;
    sh:targetClass ur:EvaluationReference .

[] a sh:NodeShape ;
    sh:property [ sh:in ( "限时解决"@zh "尽力解决"@zh ) ;
            sh:maxCount 1 ;
            sh:message "整治类型若标，须在 限时解决/尽力解决 中二选一、互斥（大王2026-11-20定）"@zh ;
            sh:path ur:treatmentType ] ;
    sh:targetClass ur:RemediationSuggestion .

[] a sh:NodeShape ;
    sh:property [ sh:message "政策标准须带 policyVersion（阈值溯源）"@zh ;
            sh:minCount 1 ;
            sh:path ur:policyVersion ] ;
    sh:targetClass ur:PolicyStandard .

[] a sh:NodeShape ;
    sh:property [ sh:class ur:Community ;
            sh:maxCount 1 ;
            sh:message "小区默认 locatedIn 社区（1..1）"@zh ;
            sh:minCount 1 ;
            sh:path ur:locatedIn ] ;
    sh:targetClass ur:ResidentialQuarter .

[] a sh:NodeShape ;
    sh:property [ sh:message "指标分类须归属 ≥1 个维度（belongsToDimension，允许一对多）"@zh ;
            sh:minCount 1 ;
            sh:path ur:belongsToDimension ] ;
    sh:targetClass ur:IndicatorCategory .

[] a sh:NodeShape ;
    sh:property [ sh:message "问题须绑空间单元（locatedIn，不参与传递）"@zh ;
            sh:minCount 1 ;
            sh:path ur:locatedIn ],
        [ sh:maxCount 1 ;
            sh:message "问题由且仅由一条评估结果导出（derivedFrom 1..1）"@zh ;
            sh:minCount 1 ;
            sh:path ur:derivedFrom ],
        [ sh:maxInclusive 1 ;
            sh:message "severity ∈ [0,1]（数值化，档位边界【待核】）"@zh ;
            sh:minInclusive 0 ;
            sh:path ur:severity ] ;
    sh:targetClass ur:Problem .

[] a sh:NodeShape ;
    sh:property [ sh:in ( "未配建"@zh "配建不达标"@zh "达标"@zh ) ;
            sh:maxCount 1 ;
            sh:message "判断值取 未配建 / 配建不达标 / 达标（三值，不可合并）"@zh ;
            sh:minCount 1 ;
            sh:path ur:judgementValue ],
        [ sh:class ur:SpatialUnit ;
            sh:maxCount 1 ;
            sh:message "指标判断须绑定恰好 1 个空间单元"@zh ;
            sh:minCount 1 ;
            sh:path ur:assesses ],
        [ sh:class ur:Indicator ;
            sh:maxCount 1 ;
            sh:message "指标判断须指明针对哪个指标（ofIndicator 1..1）"@zh ;
            sh:minCount 1 ;
            sh:path ur:ofIndicator ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "同一指标在同一空间单元上不得有重复判断"@zh ;
            sh:select "SELECT $this ?other WHERE { $this <https://ontology.cset-digital.cn/urban-renewal#ofIndicator> ?i ; <https://ontology.cset-digital.cn/urban-renewal#assesses> ?u . ?other <https://ontology.cset-digital.cn/urban-renewal#ofIndicator> ?i ; <https://ontology.cset-digital.cn/urban-renewal#assesses> ?u . FILTER(?other != $this) }" ],
        [ a sh:SPARQLConstraint ;
            sh:message "未配建→无证据；达标/配建不达标→至少 1 条证据"@zh ;
            sh:select "SELECT $this WHERE { $this <https://ontology.cset-digital.cn/urban-renewal#judgementValue> ?j . OPTIONAL { $this <https://ontology.cset-digital.cn/urban-renewal#basedOnEvidence> ?e } FILTER( (STR(?j) = \"未配建\" && BOUND(?e)) || (STR(?j) != \"未配建\" && !BOUND(?e)) ) }" ] ;
    sh:targetClass ur:IndicatorJudgement .

[] a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "评估结果须指明针对哪个指标（ofIndicator 1..1）"@zh ;
            sh:minCount 1 ;
            sh:path ur:ofIndicator ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "评估结果值须等于其单元范围内「判断≠达标」的条数"@zh ;
            sh:select "SELECT $this ?v ?expected WHERE { $this <https://ontology.cset-digital.cn/urban-renewal#ofIndicator> ?ind ; <https://ontology.cset-digital.cn/urban-renewal#assesses> ?ud ; <https://ontology.cset-digital.cn/urban-renewal#indicatorValue> ?v . ?anyj a <https://ontology.cset-digital.cn/urban-renewal#IndicatorJudgement> ; <https://ontology.cset-digital.cn/urban-renewal#ofIndicator> ?ind . { SELECT $this (COUNT(DISTINCT ?ij) AS ?expected) WHERE { $this <https://ontology.cset-digital.cn/urban-renewal#ofIndicator> ?ind2 ; <https://ontology.cset-digital.cn/urban-renewal#assesses> ?ud2 . OPTIONAL { ?ij <https://ontology.cset-digital.cn/urban-renewal#ofIndicator> ?ind2 ; <https://ontology.cset-digital.cn/urban-renewal#judgementValue> ?jv ; <https://ontology.cset-digital.cn/urban-renewal#assesses> ?cm . FILTER(STR(?jv) != \"达标\") ?cm <https://ontology.cset-digital.cn/urban-renewal#locatedIn>+ ?ud2 } } GROUP BY $this } FILTER(STR(?v) != STR(?expected)) }" ] ;
    sh:targetClass ur:AssessmentResult .

